PROJECT_NAME=Fasten API
DATABASE_URL=postgresql+asyncpg://fasten:change-this-password@localhost:5432/fasten
# Compose uses the same credentials to initialize PostgreSQL.
POSTGRES_USER=fasten
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=fasten
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
DB_ECHO=false

# Local authentication needs no external provider.
AUTH_MODE=local
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Public registration creates USER accounts only. Disabled by default.
AUTH_ALLOW_REGISTRATION=false

# Optional: set AUTH_MODE=oidc instead of local to use a provider.
# OIDC_ISSUER=https://identity.example.com/realms/fasten
# OIDC_AUDIENCE=fasten-api
# OIDC_ROLES_CLAIM=roles
# OIDC_ALLOW_INSECURE_HTTP=false
