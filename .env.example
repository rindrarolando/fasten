# -----------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# .env is gitignored and must be created manually.
# -----------------------------------------------------------------------

# --- Database ---
# Async SQLAlchemy driver string. Uncomment the line that matches your database
# and install the corresponding driver from requirements.txt.
#
# DB_DRIVER=mysql+aiomysql       # MySQL / MariaDB (default)
# DB_DRIVER=postgresql+asyncpg   # PostgreSQL
# DB_DRIVER=sqlite+aiosqlite     # SQLite (dev/test only)
DB_DRIVER=mysql+aiomysql

DB_HOST=0.0.0.0
DB_PORT=3306

# Default password applied to every service DB user (can be overridden
# per service with a dedicated env var, e.g. MY_SERVICE_DB_PASSWORD).
DB_DEFAULT_PASSWORD=your_password

# Set to true to echo raw SQL in the console (dev only)
DB_ECHO=false
DB_CONN_ECHO=false

# --- Logging ---
# Root logger level for the JSON stdout logs (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# --- Auth ---
# Shared secret injected by the frontend in the X-Client-Secret header.
# All user-side API routes validate this header.
CLIENT_SHARED_SECRET=change_me_in_production

# Admin credentials (hardcoded, no DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_password
